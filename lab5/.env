# PostgreSQL
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music_db
POSTGRES_PORT=5432

# Backend services (internal Docker network)
CATALOG_PORT=4001
COLLECTIONS_PORT=4002
GATEWAY_PORT=4000

# Metrics endpoints scraped by Prometheus
COLLECTOR_METRICS_PORT=9120
CATALOG_METRICS_PORT=9101
COLLECTIONS_METRICS_PORT=9102
GATEWAY_METRICS_PORT=9100

# Frontend
FRONTEND_PORT=3000

# Prometheus / Jaeger
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318

# OpenTelemetry (optional)
OTEL_LOG_LEVEL=warn
